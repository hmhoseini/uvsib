#!/usr/bin/env bash
#
# precursor-agent -- containerized synthesis-route literature-search agent.
#
# Drop-in replacement for uvsib/codes/files/precursor_agent.py (the reference
# stub). Same CLI contract, same output.json schema, so PrecursorSearchCalculation
# and PrecursorSearchParser need no changes:
#
#     precursor-agent --request=request.json --output=output.json
#
# It reads the JSON request, asks Claude Code (headless, server-side WebSearch +
# WebFetch only) for *proven* experimental synthesis routes of the target
# compound, and writes a schema-valid output.json. The wrapper -- not the model
# -- owns all file I/O and always emits a dict with a `results` list, so the
# AiiDA parser never trips ERROR_INVALID_OUTPUT even when the agent fails.
#
# Credentials come from the environment (ANTHROPIC_API_KEY or
# CLAUDE_CODE_OAUTH_TOKEN), injected by the AiiDA Computer / udocker -- never as
# a CalcJob input, so secrets stay out of the provenance graph.

AGENT_VERSION="precursor-search-container-1.0"
SEARCH_PROVIDER="anthropic-web-search"

# ---------------------------------------------------------------------------
# CLI parsing: accept --request[=]FILE / --output[=]FILE, tolerate extra flags
# (the AiiDA harness may append others), mirroring the reference stub.
# ---------------------------------------------------------------------------
REQUEST="request.json"
OUTPUT="output.json"
while [ $# -gt 0 ]; do
    case "$1" in
        --request=*) REQUEST="${1#*=}" ;;
        --output=*)  OUTPUT="${1#*=}" ;;
        --request)   shift; REQUEST="${1:-$REQUEST}" ;;
        --output)    shift; OUTPUT="${1:-$OUTPUT}" ;;
        *)           : ;;   # ignore unknown flags
    esac
    shift
done

# Always-valid fallback so the parser still gets a dict with a results list.
emit_empty() {
    # $1 = formula (may be empty/null-ish), $2 = error note
    local formula_json
    if [ -z "$1" ] || [ "$1" = "null" ]; then formula_json="null"; else formula_json="\"$1\""; fi
    jq -n \
        --argjson formula "$formula_json" \
        --arg ver "$AGENT_VERSION" \
        --arg prov "$SEARCH_PROVIDER" \
        --arg err "$2" \
        '{formula: $formula, results: [], n_results: 0,
          agent: {model: null, search_provider: $prov, version: $ver, error: $err}}' \
        > "$OUTPUT"
}

# ---------------------------------------------------------------------------
# Validate the request up front. Never abort without writing valid output.
# ---------------------------------------------------------------------------
if [ ! -f "$REQUEST" ] || ! jq -e . "$REQUEST" >/dev/null 2>&1; then
    echo "precursor-agent: missing or invalid request '$REQUEST'" >&2
    emit_empty "" "invalid_or_missing_request"
    exit 0
fi

FORMULA="$(jq -r '.chemical_formula // .reduced_formula // empty' "$REQUEST")"

# ---------------------------------------------------------------------------
# Build the prompt. The request JSON is embedded verbatim; the model gets the
# exact output schema and the hard no-fabrication rule.
# ---------------------------------------------------------------------------
REQ_TEXT="$(cat "$REQUEST")"
read -r -d '' PROMPT <<EOF
You are a materials-chemistry literature-search agent. Find PROVEN,
experimentally demonstrated synthesis routes for the target inorganic compound
in the request below, each grounded in a real, verifiable publication.

REQUEST (JSON):
${REQ_TEXT}

Rules:
- Use the WebSearch and WebFetch tools to find real publications (Crossref,
  OpenAlex, Semantic Scholar, and publisher/journal pages). Prefer primary
  experimental reports that synthesize the exact target formula (or a clearly
  identified polymorph of it).
- Honor the request filters: include only publications from "since_year" onward;
  obey "include_preprints"; prefer the listed "methods" but include other proven
  methods when found; return at most "max_results" publications.
- For each publication, extract one or more synthesis_routes. For each route give:
  method, precursors (chemical formulas), steps (ordered), conditions
  (temperature_C, time_h, atmosphere), product, confidence (0-1: your calibrated
  certainty the route is real and yields the target), and evidence (a short
  passage from the source supporting the route).
- NEVER fabricate or guess a doi, title, year, or url. Report a publication only
  if you actually found it via search/fetch and can cite a real DOI. If you
  cannot verify any real route, return an empty results array. Do not pad.

Output: respond with ONLY a single JSON object (no prose, no markdown fences),
exactly this shape:
{
  "formula": "${FORMULA}",
  "results": [
    {"doi": "...", "title": "...", "year": 2021, "url": "https://doi.org/...",
     "synthesis_routes": [
       {"method": "...", "precursors": ["..."], "steps": ["..."],
        "conditions": {"temperature_C": 0, "time_h": 0, "atmosphere": "..."},
        "product": "...", "confidence": 0.0, "evidence": "..."}
     ]}
  ]
}
If nothing proven is found, return {"formula": "${FORMULA}", "results": []}.
EOF

SYSTEM_APPEND="Output strict JSON only -- no prose, no markdown code fences. Never invent DOIs or references; an empty results array is correct when nothing is verifiable. Use only the WebSearch and WebFetch tools."

# ---------------------------------------------------------------------------
# Run Claude Code headless. server-side WebSearch/WebFetch only; default
# permission mode + an explicit allow-list means no other tool can run and the
# run cannot hang on a prompt (non-allowed tools auto-deny in -p mode).
# ---------------------------------------------------------------------------
ERRLOG="$(mktemp)"
RAW="$(printf '%s' "$PROMPT" | claude -p \
        --output-format json \
        --permission-mode default \
        --allowed-tools WebSearch WebFetch \
        ${ANTHROPIC_MODEL:+--model "$ANTHROPIC_MODEL"} \
        --append-system-prompt "$SYSTEM_APPEND" \
        2> "$ERRLOG")"
STATUS=$?
if [ $STATUS -ne 0 ]; then
    echo "precursor-agent: claude exited $STATUS" >&2
    sed 's/^/precursor-agent[claude]: /' "$ERRLOG" >&2
fi

# Pull the assistant's final text out of the result envelope.
RESULT="$(printf '%s' "$RAW" | jq -r 'if type=="object" then (.result // "") else "" end' 2>/dev/null)"

# Strip any stray markdown fences, then require an object carrying results[].
CLEAN="$(printf '%s\n' "$RESULT" | sed -E '/^[[:space:]]*```([a-zA-Z]+)?[[:space:]]*$/d')"
if printf '%s' "$CLEAN" | jq -e 'type=="object" and (.results|type=="array")' >/dev/null 2>&1; then
    BODY="$CLEAN"; ERRNOTE=""
else
    echo "precursor-agent: model returned no valid JSON object; emitting empty result set" >&2
    BODY='{"results":[]}'; ERRNOTE="agent_returned_no_valid_json"
fi

# ---------------------------------------------------------------------------
# Normalize: the wrapper sets formula / n_results / agent authoritatively and
# attaches the request as `query` for provenance (as the reference stub did).
# Pass-through everything else the model produced.
# ---------------------------------------------------------------------------
printf '%s' "$BODY" | jq \
    --argjson req "$REQ_TEXT" \
    --arg model "${ANTHROPIC_MODEL:-claude}" \
    --arg prov "$SEARCH_PROVIDER" \
    --arg ver "$AGENT_VERSION" \
    --arg err "$ERRNOTE" \
    '{
        formula:   (.formula // $req.chemical_formula // $req.reduced_formula),
        query:     $req,
        results:   (.results // []),
        n_results: ((.results // []) | length),
        agent:     ((.agent // {})
                    + {model: $model, search_provider: $prov, version: $ver}
                    + (if $err != "" then {error: $err} else {} end))
     }' > "$OUTPUT" 2>/dev/null

# If that last jq somehow failed, guarantee a valid file anyway.
if ! jq -e . "$OUTPUT" >/dev/null 2>&1; then
    emit_empty "$FORMULA" "normalization_failed"
fi

rm -f "$ERRLOG"
N="$(jq -r '.n_results' "$OUTPUT" 2>/dev/null)"
echo "precursor-agent: wrote ${N:-0} result(s) to $OUTPUT" >&2
exit 0
